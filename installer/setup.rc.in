#include <winres.h>
#include "setup_ids.h"

IDR_PLUGIN RCDATA "@VEGA_BUNDLE@/Contents/x86_64-win/Vega Vocal.vst3"
IDR_MODULEINFO RCDATA "@VEGA_BUNDLE@/Contents/Resources/moduleinfo.json"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Vega Audio"
            VALUE "FileDescription", "Instalador de Vega Vocal"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "Vega Vocal"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
